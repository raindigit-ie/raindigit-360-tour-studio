# Private customer media and local evidence never enter source control.
/originals/
/working/
/qa/
/demo-site/
/studio-workspace/
/release/
/release-multires/
/release-multires-package/
/dist/
/.playwright-cli/
/test-results/
/output/
/*.zip

# Browser derivatives are rebuilt from a local workspace.
/web-tour/panoramas/*
!/web-tour/panoramas/.gitkeep
/web-tour/thumbnails/*
!/web-tour/thumbnails/.gitkeep

# Local runtime files.
/node_modules/
.DS_Store
*.log
